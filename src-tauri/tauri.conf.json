{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Aspect Crop",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "dialog": {
        "open": true,
        "save": true
      },
      "window": {
        "setPosition": true,
        "setSize": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "com.yuma.aspect-crop"
    },
    "windows": [
      {
        "title": "Aspect Crop",
        "width": 1200,
        "height": 820,
        "resizable": true
      }
    ]
  }
}
